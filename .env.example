# Configuration profile: development | production | testing
# If unset, the application uses production.
# docker-compose sets APP_ENV=development for the app container automatically.
APP_ENV

# PostgreSQL credentials. docker-compose uses them to create the database
# and builds DATABASE_URL for the app container automatically.
# POSTGRES_USER and POSTGRES_DB default to "urlshortener"; the password is required.
POSTGRES_USER
POSTGRES_PASSWORD
POSTGRES_DB

# Secret that signs the JWT access and refresh tokens. Required, at least 32
# characters; the app refuses to start without it. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY

# Port PostgreSQL is published on, on your machine (default: 5432).
# Change it if a local PostgreSQL already uses 5432, e.g. 5433.
POSTGRES_HOST_PORT

# Database address when running the app outside Docker (required there), e.g.
# postgresql+psycopg2://urlshortener:<password>@localhost:5432/urlshortener
# Special characters in the password must be URL-encoded.
DATABASE_URL

# GeoIP database for click locations (default: geoip/dbip-city-lite.mmdb).
# Download it with: poetry run python scripts/download_geoip.py
# Without it, clicks are recorded without city and country.
GEOIP_DATABASE_PATH

# Number of trusted reverse proxies in front of the app (default: 0).
# Set it (e.g. 1) only behind a proxy you control, so the client IP is read
# from X-Forwarded-For; with 0 that header is ignored, because clients can fake it.
TRUSTED_PROXY_COUNT

# Password Redis requires (docker-compose starts Redis with --requirepass).
REDIS_PASSWORD

# Redis location when running the app outside Docker (defaults: localhost, 6379).
# docker-compose sets REDIS_HOST=redis for the app container automatically.
REDIS_HOST
REDIS_PORT

# Number of Gunicorn worker processes in the production image (default: 4).
# Not used by the development server started by docker-compose.
WEB_CONCURRENCY
